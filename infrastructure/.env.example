# BM4A local infrastructure - DEVELOPMENT ONLY placeholder values.
# Copy to infrastructure/.env and replace every "change-me" value.
# Never commit infrastructure/.env.

# PostgreSQL superuser (used only by the container and init script)
POSTGRES_DB=postgres
POSTGRES_USER=bm4a_admin
POSTGRES_PASSWORD=change-me-postgres

# Keycloak database
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# OpenFGA database
OPENFGA_DB=openfga
OPENFGA_DB_USER=openfga
OPENFGA_DB_PASSWORD=change-me-openfga-db

# BM4A platform database
PLATFORM_DB=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=change-me-platform-db

# Keycloak bootstrap admin (development only)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KC_HOSTNAME=localhost
KC_HTTP_ENABLED=true

# OpenFGA API pre-shared key (the platform sends it as a bearer token)
OPENFGA_PRESHARED_KEY=change-me-openfga-key
